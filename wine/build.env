# shellcheck shell=bash disable=SC2034
# Pinned inputs of the Wine build. Bump AI_WINE_REV whenever the output changes
# for the same Wine version (patches, flags, vkd3d-proton).

WINE_VERSION=11.12
WINE_URL="https://dl.winehq.org/wine/source/11.x/wine-$WINE_VERSION.tar.xz"
WINE_SHA256=d3bc091192d985846c9f20065cc81f21331f01e22b736b131e3449e1306671bc

VKD3D_PROTON_VERSION=3.0.1
VKD3D_PROTON_URL="https://github.com/HansKristian-Work/vkd3d-proton/releases/download/v$VKD3D_PROTON_VERSION/vkd3d-proton-$VKD3D_PROTON_VERSION.tar.zst"
VKD3D_PROTON_SHA256=3cf2315522af5e43605ef6d3c41dad91387040bf97199934f3f7ab76caaa2f0c

AI_WINE_REV=2
AI_WINE_NAME="wine-$WINE_VERSION-ai$AI_WINE_REV"

# Oldest supported glibc comes from the build image.
BUILD_IMAGE=docker.io/library/ubuntu:22.04
