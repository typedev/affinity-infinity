#!/usr/bin/env bash
# affinity-infinity: run Affinity by Canva on Linux in a self-updating Wine sandbox.
set -uo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
ROOT=$(dirname "$(dirname "$SELF")")

# shellcheck source=../versions.env
source "$ROOT/versions.env"
for _lib in common setup prefix affinity update selfupdate apl fonts webview2 dpi desktop; do
    # shellcheck source=/dev/null
    source "$ROOT/lib/$_lib.sh"
done
unset _lib

usage() {
    cat <<EOF
Usage: $AI_NAME <command> [options]

Commands:
  setup [--wine TARBALL] [--force]
                     Build the Windows environment (Wine prefix with .NET 4.8,
                     VC++ runtime, fonts) from Microsoft's installers; resumes
                     an interrupted setup. --wine installs a Wine build tarball
                     first; --force moves an existing prefix aside and rebuilds.
  setup --from-appimage PATH [--force]
                     Legacy: copy runtime and prefix from another Affinity AppImage.
  install [--exe FILE | --msi FILE] [--force]
                     Install Affinity from the official installer (downloaded
                     unless FILE is given) plus AffinityPluginLoader/WineFix.
  update [--gui]     Install a newer Affinity if one was published.
  check              Check for a newer Affinity (exit 0 = update available).
  run [FILE...]      Start Affinity. Offers to install a newer Affinity first
                     (AUTO_UPDATE_CHECK=0 in the config turns this off).
  dpi [auto|N|--gui] Show or set the interface scale (96..480, auto = from desktop).
  desktop            Install a menu entry and file associations.
  webview2           EXPERIMENTAL: install the WebView2 runtime for web panels.
                     With Wine 11.0 its browser process crashes and takes
                     Affinity down when Help is opened.
  status             Show versions and paths.

Data:   $DATA_DIR
Config: $CONFIG_FILE
EOF
}

cmd_setup() {
    local appimage="" tarball="" force=0
    while (($#)); do
        case $1 in
            --from-appimage) appimage=${2:-}; shift 2 ;;
            --wine) tarball=${2:-}; shift 2 ;;
            --force) force=1; shift ;;
            *) die "unknown setup option: $1" ;;
        esac
    done
    if [[ -n "$appimage" ]]; then
        setup_from_appimage "$appimage" "$force"
        return
    fi
    [[ -n "$tarball" ]] && runtime_install_tarball "$tarball"
    has_wine || die "no Wine runtime; run from the AppImage or pass --wine TARBALL"
    if is_setup; then
        [[ "$force" == 1 ]] || { log "already set up (use --force to rebuild)"; return 0; }
        prefix_backup
    fi
    prefix_build
}

# First start without an environment: build it, install Affinity, offer a menu entry.
first_run() {
    if ! gui_mode && [[ ! -t 0 ]]; then
        die "the Windows environment is not set up yet; run: $AI_NAME setup"
    fi
    local text="Affinity Infinity will now set up a Windows environment for Affinity:\n\n\
• .NET Framework 4.8, Visual C++ runtime and core fonts are installed from\n\
  Microsoft's official installers (about 15 minutes, ~1 GB download);\n\
• then Affinity is downloaded from affinity.studio.\n\nContinue?"
    if can_show_dialogs; then
        zenity --question --title="Affinity Infinity" --ok-label="Set up" --width=480 --text="$text" 2>/dev/null || exit 0
    else
        printf '%b ' "$text"
        local answer
        read -r answer
        [[ "$answer" == [yY]* ]] || exit 0
    fi
    prefix_build
    install_affinity
    if [[ -n "${APPIMAGE:-}" ]] && can_show_dialogs && ! foreign_integration >/dev/null &&
        zenity --question --title="Affinity Infinity" --ok-label="Add" --cancel-label="No" \
            --text="Add Affinity to the applications menu?" 2>/dev/null; then
        install_desktop
    fi
}

cmd_check() {
    require_setup
    local rc=0
    find_update || rc=$?
    case $rc in
        0) log "update available: ${NEW_VERSION} (installed: $(installed_version))" ;;
        1) log "Affinity $(installed_version) is up to date" ;;
        *) warn "could not reach $AFFINITY_URL" ;;
    esac
    return $rc
}

cmd_update() {
    local gui=0
    [[ "${1:-}" == --gui ]] && gui=1
    require_setup
    local rc=0
    find_update || rc=$?
    case $rc in
        1)
            log "Affinity $(installed_version) is up to date"
            [[ $gui == 1 ]] && zenity --info --title="Affinity" --text="Affinity $(installed_version) is up to date." 2>/dev/null
            return 0
            ;;
        2) die "could not check for updates" ;;
    esac
    if [[ $gui == 1 && "$(ask_update)" != install ]]; then
        return 0
    fi
    install_affinity --force
    [[ $gui == 1 ]] && zenity --info --title="Affinity" --text="Affinity $(installed_version) installed." 2>/dev/null
    return 0
}

cmd_run() {
    has_wine || die "no Wine runtime; run from the AppImage or: $AI_NAME setup --wine TARBALL"
    selfupdate_check "$@"
    is_setup || first_run
    wine_env
    sync_wine_build
    refresh_desktop
    if [[ ! -f "$AFFINITY_DIR/AffinityHook.exe" ]]; then
        if gui_mode; then
            zenity --question --title="Affinity" --ok-label="Install" \
                --text="Affinity is not installed yet.\nDownload it from affinity.studio and install it now?" 2>/dev/null || exit 0
            install_affinity
        else
            die "Affinity is not installed; run: $AI_NAME install"
        fi
    else
        startup_update_check
    fi

    [[ -f "$AFFINITY_DIR/d3d12.dll" ]] || install_d3d12
    [[ "$(state_get PREFIX_CONFIGURED)" == "$PREFIX_CONFIG_REV" ]] || prefix_configure
    apply_dpi

    # Hand files over as Windows paths.
    local -a args=()
    local a
    for a in "$@"; do
        if [[ -e "$a" ]]; then
            args+=("$(to_winpath "$(readlink -f "$a")")")
        else
            args+=("$a")
        fi
    done

    cd "$AFFINITY_DIR" || die "cannot enter $AFFINITY_DIR"
    "$WINE_ROOT/bin/wine" "$AFFINITY_WIN_DIR\\AffinityHook.exe" "${args[@]}" &
    local launcher=$! rc watchdog
    exit_watchdog "$launcher" &
    watchdog=$!
    wait "$launcher"
    rc=$?
    kill "$watchdog" 2>/dev/null
    # Wine processes run from the AppImage's mount; let them finish before it is unmounted.
    timeout 60 "$WINE_ROOT/bin/wineserver" -w
    return $rc
}

cmd_dpi() {
    case "${1:-}" in
        "")
            echo "configured: $(config_get DPI auto)"
            echo "detected:   $(detect_dpi)"
            echo "effective:  $(effective_dpi)"
            ;;
        --gui) dpi_dialog >/dev/null ;;
        auto) config_set DPI auto ;;
        *[!0-9]*) die "DPI must be 'auto' or a number between $DPI_MIN and $DPI_MAX" ;;
        *)
            (($1 >= DPI_MIN && $1 <= DPI_MAX)) || die "DPI must be between $DPI_MIN and $DPI_MAX"
            config_set DPI "$1"
            ;;
    esac
    [[ -n "${1:-}" ]] && log "interface scale: $(config_get DPI) (applied on next start: $(effective_dpi) DPI)"
    return 0
}

cmd_status() {
    local wine_version="" installed=""
    if has_wine; then
        wine_version=$( ([[ -f "$WINE_ROOT/BUILD" ]] && head -1 "$WINE_ROOT/BUILD") || state_get WINE_VERSION)
    fi
    installed=$(installed_version)
    cat <<EOF
data dir:        $DATA_DIR
runtime:         ${wine_version:-not set up}
prefix:          $([[ -f "$PREFIX_DIR/system.reg" ]] && echo "$PREFIX_DIR" || echo "not set up")
affinity:        ${installed:-not installed}
installer etag:  $(state_get INSTALLED_ETAG -)
plugin loader:   $(state_get APL_VERSION -) (pinned: $APL_VERSION)
webview2:        $(v=$(webview2_version); echo "${v:-not installed}")
dpi:             $(config_get DPI auto) -> $(effective_dpi)
last check:      $(t=$(state_get LAST_CHECK); [[ -n "$t" ]] && date -d "@$t" || echo never)
EOF
}

main() {
    local cmd=${1:-}
    (($#)) && shift
    case $cmd in
        setup) cmd_setup "$@" ;;
        install) install_affinity "$@" ;;
        update) cmd_update "$@" ;;
        check) cmd_check ;;
        run) cmd_run "$@" ;;
        dpi) cmd_dpi "$@" ;;
        desktop) install_desktop ;;
        webview2) require_setup; wine_env; webview2_install ;;
        status) cmd_status ;;
        "" | -h | --help | help) usage ;;
        *) usage >&2; exit 2 ;;
    esac
}

main "$@"
